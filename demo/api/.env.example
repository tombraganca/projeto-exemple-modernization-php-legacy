# Configuração local da API (copie para .env: cp .env.example .env).
# O .env fica fora do git (RN-027). Variáveis do ambiente do processo têm precedência sobre o .env.

# Caminho do arquivo SQLite (o diretório precisa existir). Relativo = a partir de demo/api.
SQLITE_PATH=./contato.sqlite

# Porta HTTP da API.
PORT=3000

# true insere 24 contatos de exemplo, só se a tabela estiver vazia.
SEED=true
